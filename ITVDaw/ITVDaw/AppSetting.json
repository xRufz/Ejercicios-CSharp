{
  "Storage": {
    "Type": "Json"
  },
  "Repository": {
    "Type": "Dapper",
    "Directory": "data",
    "ConnectionString": "Data Source =data/itv.db",
    "DropData": true,
    "SeedData": true
  },
  "Cache": {
    "Size": 5
  },
  "BackUp": {
    "Directory": "back",
    "Format": "zip"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}